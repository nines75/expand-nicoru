{
  "name": "expand-nicoru",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11.26.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier . -w -l",
    "format:ci": "prettier . -c",
    "check": "pnpm lint && pnpm format:ci"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/tampermonkey": "^5.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6"
  }
}
